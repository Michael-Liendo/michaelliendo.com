# Copia este archivo a `.env` y rellena los valores. En Cloudflare: Workers & Pages → tu proyecto → Settings → Variables and Secrets (PUBLIC_* también deben estar disponibles en el build).
# Documentación: https://kit.svelte.dev/docs/modules#$env-static-private

# --- Públicas (prefijo PUBLIC_; van al navegador) ---

# Número para wa.me, solo dígitos (ej. país + número sin +). Si está vacío, /automations oculta el botón flotante y el inicio usa el número por defecto.
PUBLIC_WHATSAPP_E164=

# --- Solo servidor (no uses PUBLIC_; no se exponen al cliente) ---

# Neon (PostgreSQL): URL de conexión. En el dashboard de Neon: Connection string → copiar (incluye sslmode).
# Con psql: psql "postgresql://user:pass@host/db?sslmode=require"
# Si no defines DATABASE_URL, el formulario de leads abre el cliente de correo (mailto).
DATABASE_URL=

# Token para listar leads vía GET /api/leads con cabecera: Authorization: Bearer <valor>
# Sin esto, el endpoint responde 503. Genera un string largo aleatorio y guárdalo solo en el servidor.
ADMIN_LEADS_TOKEN=
