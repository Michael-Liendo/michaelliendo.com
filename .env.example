# Copia este archivo a `.env` y rellena los valores. En Vercel: Project Settings → Environment Variables.
# Documentación: https://kit.svelte.dev/docs/modules#$env-static-private

# --- Públicas (prefijo PUBLIC_; van al navegador) ---

# Número para wa.me, solo dígitos (ej. país + número sin +). Si está vacío, no se muestra el botón flotante de WhatsApp en /automations.
PUBLIC_WHATSAPP_E164=

# --- Solo servidor (no uses PUBLIC_; no se exponen al cliente) ---

# Turso (SQLite en la nube): guarda los envíos del formulario de leads. Crea una DB en https://turso.tech y copia URL + token.
# Si no las defines, el formulario usa LEADS_WEBHOOK_URL o, en último caso, abre el cliente de correo (mailto).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Opcional: URL de un webhook (Zapier, Make, n8n, etc.) que reciba POST JSON con name, email, phone, process, wantsGuide, locale, submittedAt.
LEADS_WEBHOOK_URL=

# Token para listar leads vía GET /api/leads con cabecera: Authorization: Bearer <valor>
# Sin esto, el endpoint responde 503. Genera un string largo aleatorio y guárdalo solo en el servidor.
ADMIN_LEADS_TOKEN=
